<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.HayateOP.Extensions.ObjectPoolCompat</AssemblyName>
        <PackageId>DotNetCore.HayateOP.Extensions.ObjectPoolCompat</PackageId>
        <Description>DotNetCore Hayate Object Pool compatibility adapter for Microsoft.Extensions.ObjectPool (ObjectPool&lt;T&gt;/ObjectPoolProvider)</Description>
    </PropertyGroup>

	<PropertyGroup>
		<RootNamespace />
	</PropertyGroup>

    <Import Project="..\..\common.props" />

    <!-- net48 兼容（S2）：仅本库追加，不动 common.props 以免波及测试与全部扩展 -->
    <PropertyGroup>
        <TargetFrameworks>net48;$(TargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <Import Project="references.props" />

</Project>
