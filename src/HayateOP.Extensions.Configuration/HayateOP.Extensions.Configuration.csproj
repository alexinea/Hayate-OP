<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.HayateOP.Extensions.Configuration</AssemblyName>
        <PackageId>DotNetCore.HayateOP.Extensions.Configuration</PackageId>
        <Description>DotNetCore Hayate Object Pool Configuration Extensions</Description>
    </PropertyGroup>

	<PropertyGroup>
		<RootNamespace />
	</PropertyGroup>

    <Import Project="..\..\common.props" />

    <!-- net48 覆盖（B7 / W-B7-1）：与 DependencyInjection 同一写法——仅本库追加，不动 common.props
         以免波及测试与其余扩展包。appsettings 绑定此前在 net48 上完全不可用。 -->
    <PropertyGroup>
        <TargetFrameworks>net48;$(TargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <Import Project="dependency.props" />

    <Import Project="references.props" />

</Project>
