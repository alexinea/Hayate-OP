<Project>

    <Import Project="..\..\asset\props\dependency.versions.props" />

    <!-- net48 覆盖（B7 / W-B7-2）：M.E 8.x 包族含 netstandard2.0 / net462 资产（DI 包 net48 已实证），
         故 net48 取 8.x 一支，与 net8.0 同版本；硬约束是「core 与其它扩展包的依赖面不变」，
         本段只对本包 net48 生效。
         本包的 `Microsoft.Extensions.Logging.Abstractions` 是日志线的**锚**（L9）。 -->
    <ItemGroup Condition=" '$(TargetFramework)' != '' ">
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(HayateConfigurationVersion)" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="$(HayateConfigurationBinderVersion)" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(HayateOptionsConfigurationExtensionsVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(HayateMelLoggingAbstractionsVersion)" />
    </ItemGroup>

</Project>
