<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.HayateOP</AssemblyName>
        <PackageId>DotNetCore.HayateOP</PackageId>
        <Description>DotNetCore Hayate Object Pool library</Description>
    </PropertyGroup>

    <Import Project="..\..\common.props" />

    <!-- net48 兼容（S2）：仅本库追加，不动 common.props 以免波及测试与全部扩展 -->
    <PropertyGroup>
        <TargetFrameworks>net48;$(TargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <RootNamespace>DotNetCore.HayateOP</RootNamespace>
    </PropertyGroup>

</Project>
