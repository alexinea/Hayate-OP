<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\common.tests.props" />

    <!-- ================================================================
         FUTURE 世代测试项目（面向未来，主开发焦点）
         - 目标框架：net8.0;net9.0;net10.0
         - 测试框架：xunit v3 + Microsoft.Testing.Platform (MTP)
         - 自执行测试程序(OutputType=Exe)
         说明：xunit v3 仅支持 net8.0+，故 net6/net7 的兼容测试见
         tests/legacy/HayateOP.Tests.Legacy（xunit v2 + VSTest）。
         新增用例需在 future 与 legacy 同步维护（除非某代不适用）。
    ================================================================ -->
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>DotNetCore.HayateOP.Tests</RootNamespace>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <!-- .NET 8/9 SDK 下让 dotnet test 走 MTP；.NET 10 SDK 默认即 MTP -->
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- 切换为 Microsoft.Testing.Platform v2 Runner（而非 xunit in-process runner），
             使 MTP 扩展（含 Microsoft.Testing.Extensions.CodeCoverage）的 coverage 参数生效 -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Moq" Version="4.20.72" />
        <!-- xunit.v3 聚合包：net8/9/10 编译并链接 v3 core/assert，并引入 MTP -->
        <PackageReference Include="xunit.v3" Version="4.0.0" />
        <!-- MTP 代码覆盖率扩展：随 Microsoft.Testing.Platform.MSBuild 自动注册，
             直跑自执行测试 exe 时传 coverage 与 cobertura 输出参数即可（见任务 #28） -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\HayateOP\HayateOP.csproj" />
      <ProjectReference Include="..\..\src\HayateOP.Extensions.Specialized\HayateOP.Extensions.Specialized.csproj" />
      <ProjectReference Include="..\..\src\HayateOP.Extensions.Buffers\HayateOP.Extensions.Buffers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
