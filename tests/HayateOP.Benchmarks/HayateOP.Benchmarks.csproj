<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\HayateOP\HayateOP.csproj" />
		<ProjectReference Include="..\..\src\HayateOP.Extensions.Specialized\HayateOP.Extensions.Specialized.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="ZString" Version="2.6.0" />
		<PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.3" />
		<!-- N5: marklauter MSL.Pool head-to-head reference column (net10-only, async-only leasing API). -->
		<PackageReference Include="MSL.Pool" Version="7.2.1" />
		<!-- T8: RRode TinyPools head-to-head reference column. The package ships a net40-only asset
		     (built 2016, MIT), which still resolves on net10.0 through the net461 asset-target
		     fallback; NuGet reports that as NU1701, suppressed here because the reference is
		     deliberate and benchmark-only, so the warning would otherwise repeat on every restore. -->
		<PackageReference Include="TinyPools" Version="1.0.1" NoWarn="NU1701" />
		<!-- O8->M1+: Hertzole PowerPools head-to-head reference column. Unlike TinyPools this package
		     ships a full modern TFM ladder (netstandard2.0 through net9.0), so net10.0 resolves the
		     net9.0 asset by nearest-TFM selection with no asset-target fallback and no NU1701. -->
		<PackageReference Include="Hertzole.PowerPools" Version="1.0.0" />
		<!-- O5->M1+: Chopin.Pooling head-to-head reference column. The package (an Apache Commons
		     Pool port by labijie.com) ships net452 plus netstandard1.6 assets; net10.0 resolves the
		     netstandard1.6 asset directly as a compatible modern target, so there is no
		     asset-target fallback and no NU1701 - hence no NoWarn, unlike the TinyPools reference. -->
		<PackageReference Include="Chopin.Pooling" Version="1.0.2" />
		<!-- C-B: CnCSharp-Dev PoolingLib head-to-head reference column. The package ships a single
		     netstandard2.0 asset and no dependencies; net10.0 selects it directly as a compatible
		     modern target, so there is no asset-target fallback and no NU1701 - hence no NoWarn,
		     unlike the TinyPools reference. Verified in obj/project.assets.json after restore. -->
		<PackageReference Include="PoolingLib" Version="1.0.3" />
		<!-- G-3 (second batch 33-R-1): thomhurst Reservoir head-to-head reference column. This is the
		     only project in either research batch that combines production-grade engineering, a
		     reproducible benchmark suite and a genuinely concurrent architecture, and its published
		     concurrent numbers are the one piece of evidence that HayateOP may actually be slower
		     under contention - which is why it earns a column rather than a footnote. The package
		     ships netstandard2.0 / net8.0 / net10.0 assets with zero dependencies, so net10.0
		     resolves its own asset directly: no asset-target fallback and no NU1701, hence no
		     NoWarn, like the PowerPools and Chopin references and unlike TinyPools. Benchmark-only:
		     the core package's zero-dependency design is deliberate, so this reference must never
		     reach a shipped package. -->
		<PackageReference Include="Reservoir" Version="1.9.1" />
	</ItemGroup>

</Project>
